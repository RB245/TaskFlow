# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these itself.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Postgres (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow

# Redis - used for both the cache and the Celery broker/result backend
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth. Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_EMPTY_TTL_SECONDS=15

# Background jobs
OVERDUE_SCAN_INTERVAL_SECONDS=60
OVERDUE_SCAN_BATCH_SIZE=500
